{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <section class="hero">
        <p class="eyebrow">Application pédagogique Symfony</p>
        <h1>Bienvenue dans le laboratoire des tests de sécurité</h1>
        <p class="hero-copy">
            Chaque écran correspond à un scénario du cours : accès, validation,
            CSRF, XSS, IDOR, injection SQL, honeypot et limitation de débit.
        </p>

        {# <div class="hero-actions">
            <a class="button" href="{{ path('app_login') }}">Commencer les exercices</a>
            <a class="button button-secondary" href="{{ path('app_contact') }}">Tester le honeypot</a>
        </div> #}
    </section>

    <section aria-labelledby="scenarios-title">
        <div class="section-heading">
            <p class="eyebrow">Un terrain d'entraînement sans fumée artificielle</p>
            <h2 id="scenarios-title">Les scénarios disponibles</h2>
        </div>

        <div class="card-grid">
            <article class="card">
                <span class="card-number">01</span>
                <h3>Contrôle d'accès</h3>
                <p>Anonyme, utilisateur et administrateur face à des routes protégées.</p>
                <code>/account · /dashboard · /admin</code>
            </article>

            <article class="card">
                <span class="card-number">02</span>
                <h3>Validation serveur</h3>
                <p>Contraintes Symfony, valeurs inattendues et charge utile JSON invalide.</p>
                <code>/register · /api/register</code>
            </article>

            <article class="card">
                <span class="card-number">03</span>
                <h3>Protection CSRF</h3>
                <p>FormType automatique et vérification manuelle d'une suppression.</p>
                <code>/account/edit · /account/delete</code>
            </article>

            <article class="card">
                <span class="card-number">04</span>
                <h3>XSS et injection SQL</h3>
                <p>Échappement Twig et tentative de détournement du formulaire de connexion.</p>
                <code>/comments · /login</code>
            </article>

            <article class="card">
                <span class="card-number">05</span>
                <h3>IDOR</h3>
                <p>Un Voter empêche un utilisateur de consulter la commande d'un autre.</p>
                <code>/orders/{id}</code>
            </article>

            <article class="card">
                <span class="card-number">06</span>
                <h3>Résistance aux attaques</h3>
                <p>Honeypot, RateLimiter et réponse HTTP 429 après des soumissions excessives.</p>
                <code>/contact</code>
            </article>
        </div>
    </section>
{% endblock %}
